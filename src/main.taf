<shell>
# 仅暴露显式安装并通过完整性检查的资源，不解析上游参数、不选择科学成员。
taf_plink2_mount() {
    taf_p_backend="$1"
    case "${TAFFISH_PLINK2_RESOURCE_AUTO_MOUNT:-1}" in
        0|false|FALSE|no|NO|off|OFF) printf -- '--env=TAFFISH_ENV=TAFFISH'; return ;;
        1|true|TRUE|yes|YES|on|ON) ;;
        *) printf >&2 'taf-plink2: RESOURCE_AUTO_MOUNT must be 0 or 1\n'; printf -- '--taf-plink2-invalid-resource'; return ;;
    esac
    taf_p_root="${TAFFISH_PLINK2_RESOURCE_PATH:-}"
    if test "${TAFFISH_PLINK2_RESOURCE_PATH+x}" != x; then
        for taf_p_path in "${HOME}/.local/share/taffish/resources/plink2" /usr/local/share/taffish/resources/plink2 /opt/taffish/resources/plink2; do
            if test -e "$taf_p_path" || test -L "$taf_p_path"; then taf_p_root="$taf_p_path"; break; fi
        done
        if test -z "$taf_p_root"; then printf -- '--env=TAFFISH_ENV=TAFFISH'; return; fi
    fi
    taf_p_ok=1
    if ! test -d "$taf_p_root"; then taf_p_ok=0; else
        taf_p_root="$(CDPATH= cd "$taf_p_root" && pwd -P)" || taf_p_ok=0
        case "$taf_p_root" in *:*|*,*) taf_p_ok=0 ;; esac
        taf_p_members=0
        for taf_p_member in "$taf_p_root"/*; do
            test -e "$taf_p_member" || test -L "$taf_p_member" || continue
            taf_p_members=$((taf_p_members + 1))
            if test -L "$taf_p_member" || ! test -d "$taf_p_member"; then taf_p_ok=0; break; fi
            for taf_p_marker in receipt.json SHA256SUMS READY; do
                if test -L "$taf_p_member/$taf_p_marker" || ! test -s "$taf_p_member/$taf_p_marker"; then taf_p_ok=0; fi
            done
            test "$taf_p_ok" = 1 || break
            taf_p_hash="$(if command -v sha256sum >/dev/null 2>&1; then sha256sum "$taf_p_member/SHA256SUMS"; else shasum -a 256 "$taf_p_member/SHA256SUMS"; fi)"
            test "${taf_p_hash%% *}" = "$(cat "$taf_p_member/READY")" || taf_p_ok=0
            taf_p_n=0
            taf_p_seen='|'
            taf_p_receipt=0
            while read -r taf_p_sum taf_p_name taf_p_extra; do
                case "$taf_p_sum" in ''|*[!0-9a-f]*) taf_p_ok=0;; esac
                test "${#taf_p_sum}" = 64 || taf_p_ok=0
                case "$taf_p_name" in ''|.*|*[!A-Za-z0-9_.-]*|READY|SHA256SUMS) taf_p_ok=0;; esac
                test -z "$taf_p_extra" || taf_p_ok=0
                case "$taf_p_seen" in *"|$taf_p_name|"*) taf_p_ok=0;; esac
                taf_p_seen="$taf_p_seen$taf_p_name|"
                test "$taf_p_name" != receipt.json || taf_p_receipt=1
                if test -L "$taf_p_member/$taf_p_name" || ! test -f "$taf_p_member/$taf_p_name"; then taf_p_ok=0; fi
                test "$taf_p_ok" = 1 || break
                taf_p_hash="$(if command -v sha256sum >/dev/null 2>&1; then sha256sum "$taf_p_member/$taf_p_name"; else shasum -a 256 "$taf_p_member/$taf_p_name"; fi)"
                test "${taf_p_hash%% *}" = "$taf_p_sum" || taf_p_ok=0
                taf_p_n=$((taf_p_n + 1))
            done < "$taf_p_member/SHA256SUMS"
            taf_p_actual=0
            for taf_p_file in "$taf_p_member"/* "$taf_p_member"/.[!.]* "$taf_p_member"/..?*; do
                test -e "$taf_p_file" || test -L "$taf_p_file" || continue
                taf_p_actual=$((taf_p_actual + 1))
            done
            test "$taf_p_receipt" = 1 && test "$taf_p_n" -ge 2 && test "$taf_p_actual" = "$((taf_p_n + 2))" || taf_p_ok=0
        done
        test "$taf_p_members" -gt 0 || taf_p_ok=0
    fi
    if test "$taf_p_ok" != 1; then
        printf >&2 'taf-plink2: invalid/unprepared resource root: %s; verify or choose RESOURCE_PATH; RESOURCE_AUTO_MOUNT=0 disables discovery for setup/manual binds.\n' "$taf_p_root"
        printf -- '--taf-plink2-invalid-resource'; return
    fi
    if test "$taf_p_backend" = apptainer; then
        printf -- '--bind=%s:/references:ro' "$taf_p_root"
    else
        printf -- '--volume=%s:/references:ro' "$taf_p_root"
    fi
}
<taf-app:container:ghcr.io/taffish/plink2:2.0.0-a.7.13-r1$@[docker/podman: "$(taf_plink2_mount docker)"][apptainer: "$(taf_plink2_mount apptainer)"]>
plink2 ::*ARGV*::
