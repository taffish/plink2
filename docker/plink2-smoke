#!/bin/sh
# 每个模式独立、断网、自包含；保留 stage/退出码/有界日志。
set -eu
mode=${1:?mode required}
tmp=$(mktemp -d /tmp/taf-plink2-smoke.XXXXXX)
stage=init
finish() {
    rc=$?
    trap - EXIT
    if [ "$rc" != 0 ]; then
        printf >&2 'plink2-smoke: FAIL mode=%s stage=%s exit=%s\n' "$mode" "$stage" "$rc"
        for f in "$tmp"/*.log; do
            [ -f "$f" ] || continue
            printf >&2 '\n--- %s ---\n' "$f"
            tail -n 25 "$f" >&2
        done
    else
        printf 'plink2-smoke: PASS %s\n' "$mode"
    fi
    rm -rf "$tmp"
    exit "$rc"
}
trap finish EXIT
cd "$tmp"
run() { stage=$1; shift; "$@" > "$stage.log" 2>&1; }
case "$mode" in
identity)
    stage=identity
    grep -Fx 'PLINK 2.0 2.0.0-a.7.13' /opt/plink2/share/doc/plink2/source.txt
    grep -Fx 'SHA256: d125cd76cc284aa41c133add511b5030413e764b40d731fd38588dbd5104c6f6' /opt/plink2/share/doc/plink2/source.txt
    for f in COPYING COPYING.LESSER simde-COPYING libdeflate-COPYING zstd-COPYING zstd-LICENSE; do
        test -s "/opt/plink2/share/licenses/plink2/$f"
    done
    ;;
interface)
    run version plink2 --version
    grep -Fx 'PLINK v2.0.0-a.7.13 64-bit (15 Oct 2026)' version.log
    run help plink2 --help
    for opt in --make-pgen --glm --pca --hardy --export; do grep -F -- "$opt" help.log >/dev/null; done
    run subset-version vcf_subset --version
    grep -Fx 'vcf_subset v1.1.0 64-bit (16 May 2026)' subset-version.log
    run subset-help vcf_subset --help
    for opt in --extract --exclude --keep; do grep -F -- "$opt" subset-help.log >/dev/null; done
    ;;
linkage)
    run linkage ldd /opt/plink2/bin/plink2
    for lib in libopenblas liblapack libz.so; do grep -F "$lib" linkage.log >/dev/null; done
    if grep -F 'not found' linkage.log; then exit 1; fi
    run subset-linkage ldd /opt/plink2/bin/vcf_subset
    grep -F libz.so subset-linkage.log >/dev/null
    if grep -F 'not found' subset-linkage.log; then exit 1; fi
    ;;
core)
    run dummy plink2 --dummy 64 24 acgt --seed 42 --threads 1 --memory 640 --make-pgen --out tiny
    for f in tiny.pgen tiny.pvar tiny.psam; do test -s "$f"; done
    run statistics plink2 --pfile tiny --freq --hardy --missing --threads 1 --memory 640 --out stats
    for f in stats.afreq stats.hardy stats.vmiss stats.smiss; do test -s "$f"; done
    run export plink2 --pfile tiny --export vcf --threads 1 --memory 640 --out exported
    grep -F '#CHROM' exported.vcf
    run components plink2 --pfile tiny --maf 0.1 --pca 2 --threads 1 --memory 640 --out pca
    test -s pca.eigenvec
    test -s pca.eigenval
    ;;
multiallelic)
    printf '%b\n' '##fileformat=VCFv4.2' '##contig=<ID=1,length=1000>' '##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">' '#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\ts1\ts2\ts3\ts4' '1\t10\ttri\tA\tC,G\t.\tPASS\t.\tGT\t0|1\t1|2\t2|0\t1|2' > phased.vcf
    run import plink2 --vcf phased.vcf --make-pgen --out phased --threads 1 --memory 640
    run frequencies plink2 --pfile phased --freq --out freq --threads 1 --memory 640
    stage=assert-frequency
    awk 'BEGIN {ok=0} $2=="tri" && $3=="A" && $4=="C,G" && $5=="0.375,0.375" && $6==8 {ok=1} END {exit !ok}' freq.afreq
    ;;
subset)
    printf '%b\n' '##fileformat=VCFv4.2' '##contig=<ID=1,length=1000>' '##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">' '#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\ts1\ts2' '1\t10\trs1\tA\tG\t50\tPASS\t.\tGT\t0/0\t0/1' '1\t20\trs2\tC\tT\t60\tPASS\t.\tGT\t0/1\t1/1' > tiny.vcf
    gzip -c tiny.vcf > tiny.vcf.gz
    run subset vcf_subset --in tiny.vcf.gz --out keep.vcf --indv s2
    awk -F '\t' '/^#CHROM/ {if(NF==10 && $10=="s2") ok=1} END {exit !ok}' keep.vcf
    printf '%s\n' rs2 > ids
    run extract vcf_subset --in tiny.vcf --out extract.vcf --extract ids
    run exclude vcf_subset --in tiny.vcf --out exclude.vcf --exclude ids
    awk -F '\t' '!/^#/ {n++; if($3!="rs2") bad=1} END {exit !(n==1 && !bad)}' extract.vcf
    awk -F '\t' '!/^#/ {n++; if($3!="rs1") bad=1} END {exit !(n==1 && !bad)}' exclude.vcf
    ;;
errors)
    stage=invalid-mac
    rc=0; plink2 --mac notanumber > bad.log 2>&1 || rc=$?
    test "$rc" = 8
    grep -F "Invalid --mac argument 'notanumber'" bad.log
    stage=missing-file
    rc=0; plink2 --pfile missing --freq --out absent --memory 640 > missing.log 2>&1 || rc=$?
    test "$rc" -ne 0
    grep -F Error missing.log
    ;;
adjust)
    printf '%b\n' '#ID\tP' 'tiny\t1e-50' 'small\t1e-20' 'ordinary\t0.01' > pvals.tsv
    run adjust plink2 --adjust-file pvals.tsv cols=unadj,sidakss,sidaksd --out adjusted --memory 640
    stage=assert-sidak
    python3 - <<'PY'
import math
from pathlib import Path
rows = [line.split() for line in Path('adjusted.adjusted').read_text().splitlines()]
assert rows[0] == ['#ID', 'UNADJ', 'SIDAK_SS', 'SIDAK_SD'], rows[0]
for i, (name, raw, single, step) in enumerate(rows[1:]):
    p = float(raw)
    for value, n in ((single, 3), (step, 3 - i)):
        expected = -math.expm1(n * math.log1p(-p))
        assert math.isclose(float(value), expected, rel_tol=1e-5, abs_tol=0), (name, value, expected)
assert len(rows) == 4
PY
    stage=missing-test-column
    rc=0; plink2 --adjust-file pvals.tsv test=ADD --out rejected --memory 640 > rejected.log 2>&1 || rc=$?
    test "$rc" -ne 0
    grep -F 'TEST' rejected.log
    ;;
read-freq)
    printf '%b\n' '##fileformat=VCFv4.2' '##contig=<ID=1,length=1000>' '##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">' '#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\ts1\ts2' '1\t10\trs1\tA\tG\t.\tPASS\t.\tGT\t0/0\t0/1' '1\t20\trs2\tC\tT\t.\tPASS\t.\tGT\t0/0\t0/0' > tiny.vcf
    run import plink2 --vcf tiny.vcf --make-pgen --out tiny --memory 640
    printf '%b\n' '#CHROM\tID\tREF\tALT\tALT_FREQS\tOBS_CT' '1\trs1\tA\tT\t0.4\t100' '1\trs2\tC\tT\t0.45\t100' > external.afreq
    run read-freq plink2 --pfile tiny --read-freq external.afreq --maf 0.4 --write-snplist --out selected --memory 640
    stage=assert-frequency-import
    test "$(cat selected.snplist)" = rs2
    grep -F '1 variant' read-freq.log
    ;;
update-map)
    run dummy plink2 --dummy 8 3 --seed 42 --threads 1 --memory 640 --make-pgen --out tiny
    awk '!/^#/ {n++; print $3, (n==2 ? -1 : 100*n)}' tiny.pvar > positions.txt
    run update-map plink2 --pfile tiny --update-map positions.txt --make-pgen --out mapped --memory 640
    stage=assert-updated-positions
    awk '!/^#/ {n++; if($2!=100 && $2!=300) bad=1} END {exit !(n==2 && !bad)}' mapped.pvar
    run validate plink2 --pfile mapped --validate --memory 640
    ;;
mendel)
    # 合成家系及低频非子代基因型；检查 a.7.13 修复附近路径，不使用真实研究数据。
    stage=fixture
    python3 - <<'PY'
from pathlib import Path
ids = ['father', 'mother', 'child'] + ['other' + str(i) for i in range(97)]
header = '##fileformat=VCFv4.2\n##contig=<ID=1,length=1000>\n##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">\n'
header += '#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\t' + '\t'.join(ids) + '\n'
rows = []
for i in range(20):
    calls = ['0/0'] * 100
    calls[2] = '1/1'
    calls[3] = '0/1'
    rows.append('1\t' + str(i+1) + '\tv' + str(i) + '\tA\tG\t.\tPASS\t.\tGT\t' + '\t'.join(calls))
Path('trios.vcf').write_text(header + '\n'.join(rows) + '\n')
Path('parents.txt').write_text('F child father mother\n')
Path('sex.txt').write_text('F father 1\nF mother 2\nF child 1\n')
PY
    run import plink2 --vcf trios.vcf --const-fid F --make-pgen --out raw --memory 640 --threads 1
    run parents plink2 --pfile raw --update-parents parents.txt --update-sex sex.txt --make-pgen --out family --memory 640 --threads 1
    run mendel plink2 --pfile family --mendel --out errors --memory 640 --threads 1
    test -s errors.mendel
    grep -F '20' errors.fmendel
    ;;
resources)
    run resource-help plink2-resources --help
    run resource-dry plink2-resources install --member hgdp-grch38-chry-noannot-20260930 --dry-run
    grep -F '5281419' resource-dry.log
    rc=0; plink2-resources install --dry-run > select.log 2>&1 || rc=$?
    test "$rc" -ne 0
    grep -F -- '--member is required' select.log
    ;;
*) echo >&2 "unknown mode: $mode"; exit 2 ;;
esac
