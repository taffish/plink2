#!/usr/bin/python3
"""Install explicitly selected fixed reference members, never scientific choices."""
import argparse
import ctypes
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys

# The source checkout and installed image use the same validator bytes.
sys.dont_write_bytecode = True
_validation_dir = Path(__file__).resolve().parent
if not (_validation_dir / 'resource_validation.py').is_file():
    _validation_dir = _validation_dir.parent / 'src'
sys.path.insert(0, str(_validation_dir))
import resource_validation as validation

CATALOG = Path('/opt/plink2/share/resources.json')
MARKERS = {'receipt.json', 'SHA256SUMS', 'READY'}

class Interrupted(Exception):
    def __init__(self, signum):
        self.signum = signum

def interrupt(signum, frame):
    # Preserve the first signal status; repeated forwarding must not abort cleanup.
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)
    raise Interrupted(signum)

def download(cmd):
    # Block signals until registration; clean up only the owned child session.
    signals = {signal.SIGINT, signal.SIGTERM, signal.SIGHUP}
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, signals)
    child = None
    try:
        child = subprocess.Popen(cmd, start_new_session=True,
                                 preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_SETMASK, previous))
    finally:
        try:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous)
        except BaseException:
            if child is not None and child.poll() is None:
                child.terminate()
                child.wait(timeout=10)
            raise
    try:
        return child.wait()
    finally:
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()

def promote(stage, target):
    # Linux atomic no-replace promotion also protects existing empty targets.
    libc = ctypes.CDLL(None, use_errno=True)
    rename = libc.renameat2
    if rename(-100, os.fsencode(stage), -100, os.fsencode(target), 1):
        err = ctypes.get_errno()
        if err in (errno.EINVAL, errno.ENOSYS, errno.EOPNOTSUPP):
            raise OSError(err, 'filesystem does not support atomic no-replace promotion; '
                          'completed partial retained at ' + str(stage) + '; '
                          'retry on a supporting filesystem/backend (e.g. native Linux or Podman); '
                          'existing resources were not overwritten', str(target))
        raise OSError(err, os.strerror(err), str(target))

def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for b in iter(lambda: f.read(1024 * 1024), b''):
            h.update(b)
    return h.hexdigest()

def canonical(data):
    return json.dumps(data, sort_keys=True, separators=(',', ':')).encode()

def load_catalog(path):
    return validation.load_catalog(path)

def verify(member, target, markers=True):
    return validation.verify(member, target, markers)

def main():
    p = argparse.ArgumentParser(description='Install explicitly selected checksum-pinned PLINK reference members; never downloads all by default.')
    p.add_argument('action', choices=['list', 'install', 'verify'])
    p.add_argument('--catalog', type=Path, default=CATALOG, help='schema-1 JSON; independently fixed URLs, SHA256, sizes and resource licenses')
    p.add_argument('--member', action='append', help='required explicit member ID; repeat to select multiple')
    p.add_argument('--resource-root', type=Path, help='existing writable host-bound directory for install; read-only directory for verify')
    p.add_argument('--dry-run', action='store_true')
    p.add_argument('--source-dir', type=Path, help='offline directory containing the exact catalog files; checksum rules unchanged')
    a = p.parse_args()
    data = load_catalog(a.catalog)
    if a.action == 'list':
        print(json.dumps(data, indent=2)); return
    if not a.member:
        p.error('--member is required; no implicit all')
    lookup = {m['id']: m for m in data['members']}
    chosen = [lookup[key] for key in dict.fromkeys(a.member)]
    if a.dry_run:
        print(json.dumps(dict(schema=1, members=chosen, download_bytes=sum(f['bytes'] for m in chosen for f in m['files']), catalog_sha256=digest(a.catalog)), indent=2)); return
    if not a.resource_root or not a.resource_root.is_dir():
        p.error('--resource-root must be an existing actual host-bound directory')
    root = a.resource_root.resolve()
    os.umask(0o022)
    # Validate every installed member, including those outside this selection.
    # An empty root is allowed only for an initial install; staging stays private.
    if any(not entry.name.startswith('.') for entry in root.iterdir()):
        validation.verify_root(root)
    for m in chosen:
        target = root / m['id']
        if a.action == 'verify' or target.exists() or target.is_symlink():
            verify(m, target)
            print('VERIFIED ' + m['id']); continue
        lock = root / '.plink2-resources.lock'
        fd = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'w') as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError('resource root is locked; retry after the other installer finishes')
            if any(not entry.name.startswith('.') for entry in root.iterdir()):
                validation.verify_root(root)
            if target.exists() or target.is_symlink():
                verify(m, target); print('VERIFIED ' + m['id']); continue
            partial = root / ('.partial-' + hashlib.sha256(canonical(m)).hexdigest())
            if partial.is_symlink():
                raise ValueError('refusing symlink staging directory')
            partial.mkdir(mode=0o700, exist_ok=True)
            if partial.stat().st_uid != os.getuid() or partial.stat().st_mode & 0o077:
                raise ValueError('staging must be private and owned by this installer')
            if any(x.name != 'member' for x in partial.iterdir()):
                raise ValueError('unexpected staging content; preserve legacy partial and use a new root')
            stage = partial / 'member'
            if stage.is_symlink():
                raise ValueError('refusing symlink member staging')
            stage.mkdir(mode=0o700, exist_ok=True)
            allowed = {f['name'] for f in m['files']} | MARKERS
            if any(x.is_symlink() or not x.is_file() or x.name not in allowed for x in stage.iterdir()):
                raise ValueError('unexpected staging content')
            required = sum(f['bytes'] for f in m['files']) + 16 * 1024**2
            if shutil.disk_usage(root).free < required:
                raise ValueError('insufficient disk space (needs member size plus 16 MiB safety margin)')
            for f in m['files']:
                dst = stage / f['name']
                if dst.exists() and dst.stat().st_size == f['bytes'] and digest(dst) == f['sha256']:
                    dst.chmod(0o644)
                    continue
                if dst.exists() and dst.stat().st_size >= f['bytes']:
                    raise ValueError('corrupt cached file; preserve evidence and use a new root: ' + str(dst))
                print('FETCH ' + f['name'] + ' (partial retained on interruption)', flush=True)
                if a.source_dir:
                    source = a.source_dir / f['name']
                    if source.is_symlink() or not source.is_file() or source.stat().st_size != f['bytes'] or digest(source) != f['sha256']:
                        raise ValueError('offline source checksum/size mismatch')
                    with source.open('rb') as src:
                        if dst.exists():
                            with dst.open('rb') as old:
                                for chunk in iter(lambda: old.read(1024 * 1024), b''):
                                    if src.read(len(chunk)) != chunk:
                                        raise ValueError('partial prefix mismatch; retained without overwrite')
                        with dst.open('ab' if dst.exists() else 'xb') as out:
                            shutil.copyfileobj(src, out, 1024 * 1024)
                            out.flush(); os.fsync(out.fileno())
                else:
                    cmd = ['curl', '--fail', '--location', '--proto', '=https', '--proto-redir', '=https', '--retry', '2', '--connect-timeout', '30', '--speed-time', '60', '--speed-limit', '1024', '--continue-at', '-', '--output', str(dst), f['url']]
                    rc = download(cmd)
                    if rc:
                        raise ValueError('download failed exit=' + str(rc) + '; partial retained for resume at ' + str(stage))
                if dst.stat().st_size != f['bytes'] or digest(dst) != f['sha256']:
                    raise ValueError('download checksum mismatch; no install promoted')
                dst.chmod(0o644)
            (stage / 'receipt.json').write_text(json.dumps(m, indent=2) + '\n')
            (stage / 'receipt.json').chmod(0o644)
            # Retry may rebuild markers, never delete installed members or payloads.
            sums = ''.join(digest(stage / name) + '  ' + name + '\n'
                           for name in sorted({'receipt.json'} | {f['name'] for f in m['files']}))
            (stage / 'SHA256SUMS').write_text(sums)
            (stage / 'READY').write_text(digest(stage / 'SHA256SUMS') + '\n')
            for name in MARKERS:
                (stage / name).chmod(0o644)
            verify(m, stage)
            stage.chmod(0o755)
            promote(stage, target)
            partial.rmdir()
            print('INSTALLED ' + str(target))

if __name__ == '__main__':
    try:
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, interrupt)
        main()
    except Interrupted as e:
        print('plink2-resources: interrupted; partial retained, old members unchanged', file=sys.stderr)
        sys.exit(128 + e.signum)
    except (ValueError, KeyError, OSError) as e:
        print('plink2-resources: ERROR: ' + str(e), file=sys.stderr)
        sys.exit(1)
